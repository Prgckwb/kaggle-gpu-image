# Single source of truth for CUDA-related version strings.
# Consumed by: Dockerfile (via --build-arg), Makefile (include), CI (GITHUB_ENV).
#
# When bumping CUDA:
#   1) Update all three values below
#   2) Update the base image digest (sha256) in Dockerfile's FROM line
#   3) CI's consistency check verifies FROM line matches CUDA_BASE_TAG
CUDA_VERSION=12.8.1
CUDA_TAG=cu128
CUDA_BASE_TAG=cuda1281
